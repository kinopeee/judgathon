{
  "name": "judgathon",
  "version": "0.0.1",
  "private": true,
  "description": "Phase 0 PoC: batch AI-judging pipeline CLI for hackathon pitch recordings",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "bin": {
    "judgathon": "scripts/judgathon.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@google/genai": "2.22.0",
    "decimal.js": "10.6.0",
    "yaml": "2.9.1",
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.2",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.39.5",
    "judgathon": "link:",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
